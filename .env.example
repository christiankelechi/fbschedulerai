# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=change-me-in-production-use-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# Database Configuration
# ==========================================
# Option 1: Full Database URL (PostgreSQL or SQLite)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fbscheduler
# For SQLite local quick testing without Docker:
# DATABASE_URL=sqlite:///db.sqlite3

# Option 2: Individual DB credentials (used by Docker Compose)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=fbscheduler
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# ==========================================
# Redis / Celery Task Queue
# ==========================================
REDIS_URL=redis://redis:6379/0
# If running Redis directly on localhost:
# REDIS_URL=redis://127.0.0.1:6379/0

# ==========================================
# Meta Graph API (Facebook Page Publishing)
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_facebook_page_numeric_id
META_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token

# ==========================================
# Zero-Cost AI Inference Providers
# ==========================================
# OpenRouter API Key (Supports free models e.g. meta-llama/llama-3.2-3b-instruct:free, mistralai/mistral-7b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key

# Hugging Face API Token (Serverless inference for image quote cards)
HUGGINGFACE_API_KEY=your_huggingface_token

