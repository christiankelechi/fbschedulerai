# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=change-me-in-production-use-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app,testserver

# ==========================================
# Database Configuration
# ==========================================
# Option 1: Full Database URL (PostgreSQL / Neon / Aiven / Supabase)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# For SQLite local quick testing:
# DATABASE_URL=sqlite:///db.sqlite3

# Option 2: Individual DB credentials (used by Docker Compose)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=fbscheduler
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# ==========================================
# Redis / Celery Task Queue
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# Timezone Settings
# ==========================================
TIME_ZONE=Africa/Lagos

# ==========================================
# Email Review & Forwarding (Zenia Email Provider)
# ==========================================
REVIEW_EMAIL=christian.eze.241801@unn.edu.ng
ZENIA_EMAIL_API_URL=https://zenia-email-api.vercel.app/api/v1/register_email
MORNING_DISPATCH_HOUR=3
EVENING_DISPATCH_HOUR=17

# ==========================================
# Zero-Cost AI Inference Providers
# ==========================================
# OpenRouter API Key (Runs 100% free with openrouter/free)
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: Model override (defaults to openrouter/free)
OPENROUTER_MODEL=openrouter/free
# Hugging Face API Token (Serverless inference for image quote cards)
HUGGINGFACE_API_KEY=your_huggingface_token

# ==========================================
# Cloudinary Media Storage (Images & Video CDN)
# ==========================================
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional full connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ==========================================
# Meta Graph API (Facebook Page Publishing)
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_facebook_page_numeric_id
META_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token
