{
  "version": 2,
  "builds": [
    {
      "src": "core_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "core_project/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning-prayer/",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/evening-bible-study/",
      "schedule": "0 16 * * *"
    }
  ]
}

